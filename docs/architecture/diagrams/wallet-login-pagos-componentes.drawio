<mxfile host="app.diagrams.net" modified="2026-10-16T20:23:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="wallet-login-pagos" name="Wallet - login y pagos">
    <mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Arquitectura de componentes - Wallet digital&#xa;Alcance: login, consulta de wallet y pagos de usuario | Angular 22 identificado; Express 5.1.0 declarado por el solicitante; vista lógica." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1600" height="65" as="geometry" />
        </mxCell>
        <mxCell id="user" value="Usuario&#xa;wallet digital" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="35" y="405" width="145" height="75" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="Frontend - Angular 22&#xa;Identificado en código, excepto donde se indica propuesto" style="swimlane;html=1;startSize=50;horizontal=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="430" height="585" as="geometry" />
        </mxCell>
        <mxCell id="auth-ui" value="SignupPage + LoginPage&#xa;formularios, validaciones y mensajes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="frontend">
          <mxGeometry x="30" y="65" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api-clients" value="SignupApi + LoginApi&#xa;clientes existentes; clientes Wallet/Payment por agregar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="frontend">
          <mxGeometry x="30" y="160" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="session" value="LoginSession&#xa;token solo en memoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="frontend">
          <mxGeometry x="30" y="255" width="370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wallet-payment-ui" value="Wallet / pagos UI - propuesto&#xa;saldo disponible, destinatario, monto, confirmación, historial y comprobante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="frontend">
          <mxGeometry x="30" y="350" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="frontend-note" value="Hoy solo se verificaron rutas signup/login; URLs auth apuntan a Beeceptor. La UI solo inicia sesión con wallet ACTIVE, aunque W0 permite autenticación también en PENDING/REJECTED." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="frontend">
          <mxGeometry x="30" y="455" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="Backend - módulos propuestos sobre Express 5.1.0&#xa;No se encontró implementación backend ejecutable en el código revisado" style="swimlane;html=1;startSize=55;horizontal=1;rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="130" width="570" height="650" as="geometry" />
        </mxCell>
        <mxCell id="api-security" value="Rutas REST + middleware de seguridad&#xa;Auth, Wallet y Payments; validar Bearer, usuario y acceso a su wallet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="25" y="70" width="520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="auth-service" value="Servicio Auth&#xa;signup/login, hash seguro, unicidad de cuenta, respuesta genérica 401 y emisión/validación de token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="25" y="165" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wallet-service" value="Servicio Wallet&#xa;saldo contable, reservado y disponible; estado ACTIVE/PENDING/REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="295" y="165" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="payment-service" value="Servicio Payments&#xa;POST /payments; GET estado, historial y comprobante; validar saldo/estado; idempotencia y reservas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="25" y="290" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="event-handler" value="Handler de confirmación&#xa;procesar eventos async sin aplicar dos veces; actualizar estado terminal y comprobante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="backend">
          <mxGeometry x="25" y="405" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wallet-store" value="Persistencia transaccional - propuesta&#xa;cuentas, wallets, pagos, reservas, ledger, claves de idempotencia y comprobantes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="backend">
          <mxGeometry x="295" y="405" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guards" value="Controles transversales&#xa;payload 413, rate limit 429, errores 503; no registrar contraseñas ni tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="backend">
          <mxGeometry x="25" y="525" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w1-contract" value="W1 documentado&#xa;KYC y creación de wallet&#xa;relación con cuenta W0 pendiente" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1370" y="185" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="Proveedor de pagos&#xa;Contrato/mock documentado; proveedor productivo e integración pendientes" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1370" y="435" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" value="W2 contempla pago PENDING, Idempotency-Key, reserva de saldo, eventos, historial y comprobante. El fixture db/get-payment.json ejemplifica GET /payments/{id}: 200 con SUCCEEDED, wallet_id, destinatario, monto, idem y fingerprint; su 500 es genérico. Fixture sintético, no proveedor productivo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="570" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Leyenda&#xa;Azul/verde: componentes frontend identificados&#xa;Naranja: componentes backend recomendados, no implementados&#xa;Gris/discontinuo: contrato o integración pendiente&#xa;Línea continua: flujo descrito en código o contrato; no implica despliegue productivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="825" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="decisions" value="Decisiones necesarias antes de producción&#xa;1) Alinear documentos DNI/CE de HU W0 con TEST en OpenAPI.  2) Definir asociación account_id-wallet_id.&#xa;3) Definir autorización/propiedad de wallet, estados que permiten operar, límites por proveedor y reglas de monto bajo.&#xa;4) Definir token (expiración, renovación, revocación) y tratamiento de eventos, timeouts, reversos y conciliación." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="825" width="720" height="135" as="geometry" />
        </mxCell>
